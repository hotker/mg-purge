  {
    "name": "boost appends its tail block after the preset prompt",
    "options": {
      "preset": "minimal",
      "boost": true
    },
    "request": {
      "model": "m",
      "system": "x"
    },
    "expect_request_contains": {
      "system": [
        "最短路径完成",
        "<dsh_boost scope=\"system\" priority=\"override\">"
      ]
    }
  },
  {
    "name": "preset off with no systemPrompt does nothing",
    "options": {
      "preset": "off",
      "boost": false
    },
