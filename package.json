{
  "name": "mg-purge",
  "version": "0.6.4",
  "description": "破甲 (purge) for magpie: dsh-purge's prompt-injection layer as a magpie gateway middleware, with a dashboard page and a Usage panel — operator-priority system prompt (presets), a concise boost tail block, refusal detection (logged, reply never altered), thinking-tag stripping, live parameter tuning.",
  "type": "module",
  "files": [
    "mg-purge.middleware.js",
    "presets",
    "page",
    "panel",
    "registry.json",
    "registry-entry.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "dsh-purge",
    "purge",
    "破甲",
    "prompt-injection",
    "system-prompt",
    "unrestricted",
    "dashboard",
    "llm-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotker/mg-purge.git"
  },
  "homepage": "https://github.com/hotker/mg-purge",
  "magpie": {
    "middleware": "./mg-purge.middleware.js",
    "page": {
      "title": "mg-purge",
      "titles": {
        "zh": "破甲 mg-purge",
        "zh-TW": "破甲 mg-purge",
        "ja": "mg-purge",
        "de": "mg-purge"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "keepAlive": true
    },
    "panels": [
      {
        "slot": "usage",
        "title": "网关调用成功率",
        "titles": {
          "zh": "网关调用成功率",
          "zh-TW": "閘道呼叫成功率",
          "ja": "Gateway success rate",
          "de": "Gateway-Erfolgsrate"
        },
        "file": "panel/index.html"
      }
    ],
    "permissions": [
      "usage:summary"
    ],
    "options": {
      "preset": "unrestricted",
      "position": "append",
      "override": true,
      "boost": false,
      "refusalDetect": true,
      "stripThink": true,
      "agents": [],
      "excludeAgents": [],
      "models": [],
      "systemPrompt": "",
      "refusalPatterns": [],
      "logErrors": true
    }
  },
  "scripts": {
    "test": "bun test"
  }
}
